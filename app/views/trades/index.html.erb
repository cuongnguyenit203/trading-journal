<p style="color: green"><%= notice %></p>


<h1 class="mb-3">Trades</h1>

<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>Symbol</th>
      <th>Entry</th>
      <th>Exit</th>
      <th>PnL</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @trades.each do |trade| %>
      <tr>
        <td><%= trade.symbol %></td>
        <td><%= trade.entry_price %></td>
        <td><%= trade.exit_price %></td>
        <td>
          <span class="<%= trade.exit_price.to_f > trade.entry_price.to_f ? 'text-success' : 'text-danger' %>">
            <%= (trade.exit_price.to_f - trade.entry_price.to_f).round(2) %>
          </span>
        </td>
        <td>
          <%= link_to "Edit", edit_trade_path(trade), class: "btn btn-sm btn-primary" %>
          <%= link_to "Delete", trade, method: :delete, class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New Trade", new_trade_path, class: "btn btn-success" %>
