<h1 class="mb-4">Trading Dashboard </h1>
<div class="row">
  <div class="col-md-3">
    <div class="card text-center mb-3">
      <div class="card-body">
        <h5 class="card-title">Total Trades</h5>
        <h2><%= @total_trades %></h2>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card text-center mb-3">
      <div class="card-body">
        <h5 class="card-title">Total Profit</h5>
        <h2 class="<%= @total_profit >= 0 ? 'text-success' : 'text-danger' %>"><%= number_to_currency(@total_profit.round(2)) %></h2>
      </div>
    </div>
  </div> 
  
  <div class="col-md-3">
    <div class="card text-center mb-3">
      <div class="card-body">
        <h5 class="card-title">Win Rate</h5>
        <h2><%= @win_rate %>%</h2>  
      </div>
    </div>
  </div>

    <div class="col-md-3">
        <div class="card text-center mb-3">
        <div class="card-body">
            <h5 class="card-title">Average PnL</h5>     
            <h2><%= @average_pnl %></h2>
        </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <%= link_to "View Trades", trades_path, class: "btn btn-primary" %>
    <%= link_to "New Trade", new_trade_path, class: "btn btn-success" %>
</div>

<div class="card mt-5">
  <div class="card-body">
    <h3 class="mb-4">PnL Chart</h3>

    <canvas
      data-controller="chart"
      data-labels="<%= @chart_labels.to_json %>"
      data-data="<%= @chart_data.to_json %>">
    </canvas>
  </div>
</div>
